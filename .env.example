# Local Postgres from docker compose (see README). Never put real credentials
# in this file -- it is committed. Put yours in .env, which is gitignored.
DATABASE_URL=postgres://acme:acme@localhost:5433/acme_ops

# Port the API listens on. The web app talks to http://localhost:4000 by default.
API_PORT=4000

# Set to 1 to log every SQL statement with its timing.
DEBUG_SQL=0
